# IMS Network server environment variables
#
# Copy this file to .env.local for local development.
# Never commit real credentials, secrets, or connection strings.

DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

DATABASE_URL_POOLED="postgresql://USER:PASSWORD@POOLED_HOST/DATABASE?sslmode=require"

BETTER_AUTH_SECRET="REPLACE_WITH_A_RANDOM_SECRET"

BETTER_AUTH_URL="http://localhost:3000"

RESEND_API_KEY="REPLACE_WITH_RESEND_API_KEY"

RESEND_FROM_EMAIL="IMS Network <onboarding@resend.dev>"

# Never expose database, authentication, or email-provider secrets
# through NEXT_PUBLIC_* variables.
