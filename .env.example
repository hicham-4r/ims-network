# IMS Network server environment variables
#
# Copy this file to .env.local for local development.
# Never commit real credentials or connection strings.

# Direct PostgreSQL connection.
# Used by Drizzle Kit for migrations and database administration.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Pooled PostgreSQL connection.
# Used by the application runtime for normal server-side queries.
DATABASE_URL_POOLED="postgresql://USER:PASSWORD@POOLED_HOST/DATABASE?sslmode=require"

# Never expose database credentials through NEXT_PUBLIC_* variables.
